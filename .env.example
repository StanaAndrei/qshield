# Q-SHIELD Operational & Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Application Environment (simulation | test | production)
QSHIELD_APP_ENV=simulation

# Database Connection URL (SQLite by default)
QSHIELD_DB_URL=sqlite:///./qshield.db

# Cryptographic Audit Salt (Change for production deployments)
QSHIELD_SECRET_AUDIT_SALT=qshield-audit-salt-simulation-secret-key-32b

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
QSHIELD_LOG_LEVEL=INFO

# API Server Host and Port
QSHIELD_API_HOST=0.0.0.0
QSHIELD_API_PORT=8000

# Default Path to Configuration Directory
QSHIELD_CONFIG_DIR=configs
